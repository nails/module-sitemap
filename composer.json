{
    "name": "nails/module-sitemap",
    "keywords": [
        "Nails",
        "Shed Collective",
        "CodeIgniter",
        "Sitemap Module"
    ],
    "homepage": "http://nailsapp.co.uk/modules/sitemap",
    "description": "This is the \"Sitemap\" module for Nails.",
    "license": "MIT",
    "authors": [
        {
            "name": "Pablo de la Pena",
            "email": "p@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        },
        {
            "name": "Gary Duncan",
            "email": "g@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hello@nailsapp.co.uk"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "nails/common": "dev-feature/pre-new-admin",
        "nails/module-console": "dev-feature/pre-new-admin"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload": {
        "psr-4": {
            "Nails\\SiteMap\\": "src/"
        }
    },
    "extra": {
        "nails": {
            "moduleName": "sitemap",
            "type": "module",
            "namespace": "Nails\\SiteMap\\"
        }
    }
}
